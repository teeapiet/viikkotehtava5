[Unit]
Description=Viikko 5 Flask-chat
After=network.target mariadb.service ollama.service
Wants=mariadb.service ollama.service

[Service]
User=chatapp
Group=www-data
WorkingDirectory=/opt/chatapp/app
EnvironmentFile=/etc/chatapp/chatapp.env
RuntimeDirectory=chatapp
RuntimeDirectoryMode=0750
ExecStart=/opt/chatapp/venv/bin/gunicorn --workers 2 --worker-class gthread --threads 8 --timeout 300 --bind unix:/run/chatapp/gunicorn.sock --umask 007 --access-logfile - app:app
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
